<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:background="@drawable/bg_nav_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:background="@drawable/bg_logo_circle"
        android:contentDescription="VitaFit logo"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher_round" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNavName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ashutosh"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtNavGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎯 Goal: Improve Fitness"
            android:textColor="#F1FFF5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtNavBMI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="⚖ BMI: 23.1 (Normal)"
            android:textColor="#F1FFF5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtCoach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="💚 Personal AI Fitness Coach"
            android:textColor="#E8F5E9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

</LinearLayout>